# The server's front door. Caddy gets and renews the HTTPS certificates by itself. The domains
# come from .env (WEB_DOMAIN, API_DOMAIN, STATS_DOMAIN, ERRORS_DOMAIN): renaming the site is a
# change there, not here.

{$WEB_DOMAIN} {
	root * /srv/web
	encode zstd gzip
	# built files carry a hash in their name: cache them for a year; the rest always revalidates
	@immutable path /_app/immutable/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	header ?Cache-Control "no-cache"
	# a single-page app: unknown paths get index.html
	try_files {path} /index.html
	file_server
}

{$API_DOMAIN} {
	encode zstd gzip
	reverse_proxy api:8131
}

{$STATS_DOMAIN} {
	reverse_proxy grafana:3000
}

{$ERRORS_DOMAIN} {
	reverse_proxy glitchtip:8000
}
