{
 "uid": "shafaq",
 "title": "Shafaq Geo",
 "tags": [
  "shafaq"
 ],
 "timezone": "browser",
 "schemaVersion": 41,
 "version": 1,
 "refresh": "1m",
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Games, last 24 h",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 5,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "round(sum(increase(shafaq_games_started_total[24h])))",
     "legendFormat": "",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area"
   }
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Rounds, last 24 h",
   "gridPos": {
    "x": 5,
    "y": 0,
    "w": 5,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "round(sum(increase(shafaq_rounds_scored_total[24h])))",
     "legendFormat": "",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area"
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "New guests, last 24 h",
   "gridPos": {
    "x": 10,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "round(sum(increase(shafaq_guests_created_total[24h])))",
     "legendFormat": "",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area"
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Yandex rounds today (ours)",
   "gridPos": {
    "x": 14,
    "y": 0,
    "w": 5,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "max(shafaq_panorama_views_today{provider=\"yandex\"})",
     "legendFormat": "",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area"
   },
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 80
       },
       {
        "color": "red",
        "value": 100
       }
      ]
     }
    }
   }
  },
  {
   "id": 5,
   "type": "stat",
   "title": "Yandex requests today (Yandex's count)",
   "gridPos": {
    "x": 19,
    "y": 0,
    "w": 5,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "max(shafaq_yandex_requests_today)",
     "legendFormat": "",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area"
   },
   "fieldConfig": {
    "defaults": {
     "noValue": "no YANDEX_CABINET_KEY",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 80
       },
       {
        "color": "red",
        "value": 100
       }
      ]
     }
    }
   }
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Requests per second",
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "sum by (code) (rate(shafaq_http_requests_total[5m]))",
     "legendFormat": "{{code}}",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "fillOpacity": 10
     }
    }
   }
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Slowest routes, p95 (s)",
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "topk(5, histogram_quantile(0.95, sum by (route, le) (rate(shafaq_http_request_seconds_bucket[5m]))))",
     "legendFormat": "{{route}}",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "fillOpacity": 0
     }
    }
   }
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Panorama rounds today, by provider",
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "max by (provider) (shafaq_panorama_views_today)",
     "legendFormat": "{{provider}}",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "expr": "max(shafaq_yandex_daily_limit) or vector(100)",
     "legendFormat": "Yandex free limit",
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "fillOpacity": 10
     }
    }
   }
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Server errors (5xx) per minute",
   "gridPos": {
    "x": 12,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "sum(rate(shafaq_http_requests_total{code=~\"5..\"}[5m])) * 60 or vector(0)",
     "legendFormat": "5xx",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "fillOpacity": 10
     }
    }
   }
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Memory (MB)",
   "gridPos": {
    "x": 0,
    "y": 20,
    "w": 12,
    "h": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "process_resident_memory_bytes{job=~\"api|worker\"} / 1e6",
     "legendFormat": "{{job}}",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "fillOpacity": 10
     }
    }
   }
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "Goroutines",
   "gridPos": {
    "x": 12,
    "y": 20,
    "w": 12,
    "h": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "go_goroutines{job=~\"api|worker\"}",
     "legendFormat": "{{job}}",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "fillOpacity": 10
     }
    }
   }
  },
  {
   "id": 12,
   "type": "logs",
   "title": "Warnings and errors",
   "gridPos": {
    "x": 0,
    "y": 27,
    "w": 24,
    "h": 10
   },
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "expr": "{service=~\".+\", level=~\"(?i)warn|warning|error|fatal\"}",
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     }
    }
   ],
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "sortOrder": "Descending"
   }
  },
  {
   "id": 13,
   "type": "logs",
   "title": "Backups (the db container)",
   "gridPos": {
    "x": 0,
    "y": 37,
    "w": 24,
    "h": 7
   },
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "expr": "{service=\"db\"} |= \"backup\"",
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     }
    }
   ],
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "sortOrder": "Descending"
   }
  }
 ]
}