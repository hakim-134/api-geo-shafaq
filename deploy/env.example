# The server's settings: copy to /srv/shafaq/api-geo-shafaq/.env (gitignored) and fill in.
# Secrets live only there, never in git. `openssl rand -hex 24` makes a good password.

ENVIRONMENT=dev

# The four addresses, all pointing (DNS A records) at the server. The only place they are named.
WEB_DOMAIN=geo.shafaq.uz
API_DOMAIN=api.geo.shafaq.uz
STATS_DOMAIN=stats.geo.shafaq.uz
ERRORS_DOMAIN=errors.geo.shafaq.uz
# COOKIE_DOMAIN=

DB_PASSWORD=
GRAFANA_PASSWORD=
GLITCHTIP_SECRET=
DEMO_SECRET=

PROVIDERS=yandex
# TEST_PROVIDERS=demo            # only on a test server: games that name it get drawn panoramas
YANDEX_DAILY_LIMIT=100
# Daily budgets in rounds, per provider (Moscow day): at its cap a provider gets no new rounds
# and games use their other providers. Unset = google=160 (Google's free 5 000 a month).
# With the free Yandex key, yandex=100 stops play at the limit instead of risking a block.
# DAILY_CAPS=google=160
# YANDEX_CABINET_KEY=

TELEGRAM_ALERT_TOKEN=
TELEGRAM_ALERT_CHAT=

# Error tracking: GlitchTip at https://ERRORS_DOMAIN → the project's DSN (Settings → Projects)
# GLITCHTIP_DSN=

# Backups (pgBackRest). Encrypted with BACKUP_PASSWORD: keep a copy of it off the server, or
# the backups cannot be read. Without S3 settings they stay on the server's disk only.
BACKUP_PASSWORD=
# BACKUP_REPO_TYPE=s3
# BACKUP_REPO_PATH=/shafaq
# BACKUP_S3_ENDPOINT=s3.example.uz
# BACKUP_S3_BUCKET=shafaq-backups
# BACKUP_S3_REGION=auto
# BACKUP_S3_KEY=
# BACKUP_S3_SECRET=
