# Copy to .envrc (gitignored) and run `direnv allow`. Defaults in internal/config fit local runs
# on a shared Postgres (with PostGIS) and Redis; set only what differs. Never put real secrets in
# the example.
export PGPASSWORD=                 # the Postgres password; pgx takes it when the URL has none
export DATABASE_URL=postgres://postgres@127.0.0.1:5432/shafaq_lcl?sslmode=disable
export VALKEY_URL=redis://127.0.0.1:6379/1
export TEST_DATABASE_URL=$DATABASE_URL
export WEB_ORIGINS=http://localhost:*,http://127.0.0.1:*
# PUBLIC_URL unset: demo images are linked relative to the API, so a phone on the LAN works too
# players get Yandex only; demo plays only in games that name it (the smoke test, the web app's
# test switch), so development never spends the free Yandex key's ~100 views a day
export PROVIDERS=yandex
export TEST_PROVIDERS=demo
export YANDEX_DAILY_LIMIT=100
# export DAILY_CAPS=google=160     # rounds per provider per day; then games use their others
# export YANDEX_CABINET_KEY=       # Developer's Account API key: the worker reads Yandex's own count
# export GOOGLE_MAPS_KEY=          # for `shafaq-tools google` (free Street View metadata look-ups)
# export TELEGRAM_ALERT_TOKEN=     # bot that warns the owner at 80% of the Yandex limit
# export TELEGRAM_ALERT_CHAT=      # write to the bot: the worker answers with the chat ID
